{
  "version": 1,
  "author": "jboucly",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-pir-motion-sensor", "id": "pir1", "top": -120, "left": 160, "attrs": { "delayTime": "2" } },
    { "type": "wokwi-led", "id": "led1", "top": 40, "left": 200, "attrs": { "color": "green", "label": "HOLD" } },
    { "type": "wokwi-resistor", "id": "r1", "top": 120, "left": 180, "attrs": { "value": "220" } },
    { "type": "wokwi-potentiometer", "id": "pot1", "top": 200, "left": 200, "attrs": { "value": "950" } }
