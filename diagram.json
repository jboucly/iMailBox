    [ "esp:3V3", "pir1:VCC", "red", [] ],
    [ "esp:14", "pir1:OUT", "green", [] ],
    [ "esp:13", "r1:1", "orange", [] ],
    [ "r1:2", "led1:A", "orange", [] ],
    [ "led1:C", "esp:GND.2", "black", [] ],
    [ "pot1:VCC", "esp:3V3", "red", [] ],
    [ "pot1:GND", "esp:GND.2", "black", [] ],
    [ "pot1:SIG", "esp:34", "blue", [] ]
  ],
  "dependencies": {}
